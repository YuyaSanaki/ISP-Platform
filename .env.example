# Copy to .env and adjust: `cp .env.example .env`
#
# --- Host UID/GID (files in bind-mounted ./ stay owned by your user) ---
# DOCKER_UID=1000
# DOCKER_GID=1000
#
# LD_PRELOAD: leave unset — the image entrypoint sets it on aarch64 only (see
# scripts/container-entrypoint.sh). Set here only to override or fix sklearn paths.
# LD_PRELOAD=...
#
# --- Build-time model download (docker compose build isp-platform) ---
# DOWNLOAD_MODELS=default   # default | minimal | all | none
# SKIP_ORTHOLOGS=0           # 1 = skip Ensembl BioMart during build
# HF_TOKEN=                  # optional; public models usually work anonymously
#
# --- Runtime seed from image → ./models + core/geneformer/dicts ---
# SKIP_MODEL_SEED=0          # 1 = do not copy baked assets into the bind mount
#
# --- ISP (optional overrides; defaults work for single GPU) ---
# ISP_NUM_GPUS=1
